# Copy to .env (git-ignored). No credentials are needed today: Yahoo Finance and
# FRED are used without keys. Placeholders for a future broker paper-trading link:
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_PAPER=true

# Optional overrides
